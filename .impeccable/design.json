  "narrative": {
    "northStar": "Mesa de operação diurna",
    "overview": "Mesa de operação diurna: superfícies claras, texto verde escuro e divisórias leves mantêm o foco na conversa. A densidade é moderada; o telefone concentra as ações e a área lateral reúne equipe, operação de filas e histórico. A linguagem permanece direta e em português.",
    "keyCharacteristics": [
      "Superfícies claras e hierarquia por espaço.",
      "Ações concentradas no telefone.",
      "Estados explícitos e números tabulares."
    ],
    "rules": [
      {
        "name": "The Estado Legível Rule",
        "body": "Todo estado tem texto além de cor; registro SIP, motor de telefonia e canal de eventos têm indicadores separados.",
        "section": "colors"
      },
      {
        "name": "The Telefone Primeiro Rule",
        "body": "Em telas estreitas, preserve a ordem telefone, equipe, operação de filas e histórico.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do associar estado a texto legível além da cor.",
      "Do manter o telefone antes da equipe, da operação de filas e do histórico em telas estreitas.",
      "Do usar números tabulares para ramais, duração e registros de chamadas.",
      "Do apresentar somente controles ligados às ações disponíveis no estado atual."
    ],
    "donts": [
      "Don't transformar estados SIP, motor e eventos em um único indicador.",
      "Don't exibir dados de equipe e histórico após sair da sessão.",
      "Don't usar sombra, gradiente ou movimento decorativo para criar hierarquia."
    ]
  }
